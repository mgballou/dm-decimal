{
    "name": "mgballou/dm-decimal",
    "description": "Layered decimal arithmetic for PHP, ported from break_eternity.js with an optional Eloquent cast.",
    "type": "library",
    "keywords": ["decimal", "break_eternity", "incremental", "idle-game", "big-numbers", "laravel", "eloquent"],
    "homepage": "https://github.com/mgballou/dm-decimal",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Ballou"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "illuminate/database": "^12.0 || ^13.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "illuminate/database": "^12.0 or ^13.0 is required only to use DecimalCast with Eloquent."
    },
    "autoload": {
        "psr-4": {
            "DreadMajesty\\Decimal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DreadMajesty\\Decimal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:conformance": "pest --testsuite=Conformance",
        "test:differential": "pest --testsuite=Differential",
        "types:check": "phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "docs": "https://github.com/mgballou/dm-decimal#readme",
        "issues": "https://github.com/mgballou/dm-decimal/issues",
        "source": "https://github.com/mgballou/dm-decimal"
    }
}
